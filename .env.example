# Required whenever Teamlet is reachable from other machines.
TEAMLET_PASSWORD=change-me

# Host folder mounted at /workspace for the agents to work in (docker compose only).
TEAMLET_WORKSPACE=./workspace

# Optional
# TEAMLET_VERSION=0.1.0           # image version to run (docker compose only; default latest)
# TEAMLET_PUBLISH=4317            # host port (docker compose only)
# TEAMLET_MAX_PARALLEL=6          # workers running at once
# TEAMLET_TRUST_PROXY=1           # set when running behind a reverse proxy (Caddy, nginx, Fly, …)
# TEAMLET_ALLOWED_ORIGINS=        # extra origins allowed to call the API, comma separated
# TEAMLET_AUTH=none               # only if an authenticating proxy already protects the app
# CLAUDE_CODE_OAUTH_TOKEN=          # from `claude setup-token`, instead of signing in through the UI
