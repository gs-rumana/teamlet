{
  "name": "teamlet",
  "productName": "Teamlet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "desktop/main.ts",
  "description": "Use your own AI subscriptions (Claude, ChatGPT/Codex) with a lead agent that delegates to parallel sub-agents.",
  "license": "MIT",
  "author": "Gursahb Singh",
  "homepage": "https://github.com/gs-rumana/teamlet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gs-rumana/teamlet.git"
  },
  "bugs": {
    "url": "https://github.com/gs-rumana/teamlet/issues"
  },
  "keywords": [
    "ai-agents",
    "claude-code",
    "codex",
    "multi-agent",
    "mcp",
    "self-hosted",
    "electron"
  ],
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\"",
    "check": "pnpm typecheck && pnpm build && pnpm test",
    "desktop": "pnpm build && electron .",
    "desktop:dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.289",
    "@modelcontextprotocol/sdk": "^1.32.0",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "electron": "44.6.0",
    "electron-builder": "26.15.3",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  }
}
